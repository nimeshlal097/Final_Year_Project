def format_complex(c):
    mag = abs(c)
    angle = math.degrees(cmath.phase(c))
    return f"{mag:.3f}∠{angle:.1f}°"

# Step 2: Main Calculation Loop
print(f"HARMONIC S-PARAMETERS AT {int(f_target)} Hz (h={int(h)})")
print("=" * 105)
print(f"{'Line Section ID':<35} | {'S11':<15} | {'S12':<15} | {'S21':<15} | {'S22':<15}")
print("-" * 105)

for line_id, p in line_data.items():
    # Frequency scaling (No skin effect)
    R_h = p['R']
    X_h = p['X'] * h
    B_h = p['B'] * h
    
    # Distributed parameters (Physical Units)
    Z_phys = complex(R_h, X_h) * Z_base
    Y_phys = complex(0, B_h) / Z_base
    
    # Propagation constant and Characteristic Impedance
    gamma = cmath.sqrt((Z_phys/p['L']) * (Y_phys/p['L']))
    Zc = cmath.sqrt((Z_phys/p['L']) / (Y_phys/p['L']))
    
    # Single Circuit ABCD
    A = cmath.cosh(gamma * p['L'])
    B = Zc * cmath.sinh(gamma * p['L'])
    C = (1/Zc) * cmath.sinh(gamma * p['L'])
    D = A
    
    # Parallel Circuit logic from Eq 4.33
    if p['DC']:
        B_eq = B / 2
        C_eq = 2 * C
    else:
        B_eq = B
        C_eq = C
    
    # Convert resulting ABCD to S-parameters (Table F.1)
    denom = A + (B_eq / Z0) + (C_eq * Z0) + D
    S11 = (A + (B_eq / Z0) - (C_eq * Z0) - D) / denom
    S12 = (2 * (A*D - B_eq*C_eq)) / denom
    S21 = 2 / denom
    S22 = S11
    
    print(f"{line_id:<35} | {format_complex(S11):<15} | {format_complex(S12):<15} | {format_complex(S21):<15} | {format_complex(S22):<15}")